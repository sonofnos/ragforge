PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ragforge
MONGODB_URI=mongodb://localhost:27017/ragforge

# Leave unset to use the deterministic fake LLM/embeddings backends (no
# network, no cost). Set to a real key to use OpenAI via LangChain's
# ChatOpenAI / OpenAIEmbeddings.
OPENAI_API_KEY=

# A Firebase service account JSON string (not a file path), e.g.
# the single-line output of `cat service-account.json`. Required to start
# the server -- there is no "fake" mode for the real server process itself,
# only for tests (see apps/api/src/auth.ts's FakeTokenVerifier).
FIREBASE_SERVICE_ACCOUNT_JSON=
